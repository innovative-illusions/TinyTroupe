###############################################################################
# TinyTroupe — environment variables
#
# Copy this file to .env and fill in the values for your chosen provider.
# Only the variables for the provider you are using are required.
#
# These variables are for API credentials only.  All other settings
# (model name, timeouts, etc.) belong in config.ini.
###############################################################################


# ===========================================================================
# OpenAI  (API_TYPE=openai)
# ===========================================================================
OPENAI_API_KEY=sk-...

# Optional: override the API endpoint (proxy, local server, etc.)
# Leave blank to use the default api.openai.com endpoint.
OPENAI_BASE_URL=


# ===========================================================================
# Azure OpenAI Service  (API_TYPE=azure)
# ===========================================================================
# Key-based authentication — leave AZURE_OPENAI_KEY blank to use
# Entra ID / managed-identity authentication instead.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/


# ===========================================================================
# Anthropic Claude  (API_TYPE=anthropic)
# ===========================================================================
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Anthropic endpoint (proxy, etc.)
ANTHROPIC_BASE_URL=


# ===========================================================================
# Groq Cloud  (API_TYPE=groq)  — https://console.groq.com
# ===========================================================================
GROQ_API_KEY=gsk_...


# ===========================================================================
# Ollama  (API_TYPE=ollama)  — local, no API key required
# ===========================================================================
# BASE_URL is configured in config.ini under [ollama].
# Use a TINYTROUPE_* env var to override it without editing config.ini:
#   TINYTROUPE_OLLAMA_BASE_URL=http://192.168.1.10:11434/v1
